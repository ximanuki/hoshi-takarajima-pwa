# Copy to .env (never commit .env). Every setting is optional.
ANTHROPIC_API_KEY=
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise extractive (no LLM)
KAI_LLM_PROVIDER=auto
KAI_CLAUDE_MODEL=claude-haiku-4-5-20251001
# KAI_CLAUDE_MODEL=claude-sonnet-5-5
KAI_ABSTAIN_THRESHOLD=0.40
KAI_TOP_K=5
KAI_RATE_LIMIT_PER_MINUTE=10
KAI_PER_IP_DAILY_CAP=100
KAI_DAILY_CAP=1000
KAI_TRUST_PROXY_HEADERS=false
